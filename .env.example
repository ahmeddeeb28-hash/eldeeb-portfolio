# Sanity — required for the case-study CMS
# Get these from https://sanity.io/manage after creating a project.

# Public values — read by Vite at build/runtime
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Server-only values — read by scripts/* (prefetch + migration)
# Read token: viewer perms; only needed if your dataset is private
SANITY_READ_TOKEN=

# Write token: editor perms; ONLY used by `npm run migrate:sary`
# Do NOT add this to Vercel — it's a one-time local migration secret.
SANITY_WRITE_TOKEN=

# Analytics — optional, set in Vercel. Each part stays off without its ID.
# Google Analytics 4 measurement ID (GA4 > Admin > Data streams > Web)
VITE_GA_ID=
# Leadfeeder / Dealfront tracker ID (Settings > Website tracking script)
VITE_LEADFEEDER_ID=
